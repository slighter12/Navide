{
  "key": "pi",
  "composition": "rust",
  "command": "pi",
  "model_flag": "--model",
  "effort_flag": "--thinking",
  "known_efforts": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
  "permission_flag": null,
  "resume_args": "--session-id {id}",
  "session_id_flag": null,
  "login_args": null,
  "resume_aliases": null,
  "subcommand": null,
  "data_dirs": {"env": ["PI_CODING_AGENT_DIR"], "home": [".pi", "agent"], "append": [], "extra_env": ["PI_CODING_AGENT_SESSION_DIR"], "tilde": false},
  "session_path": null,
  "logs": {"files": ["{cwd}/*.jsonl"], "cwd": "pi"},
  "supports_session_resume": true,
  "shutdown": null,
  "capabilities": {
    "model": "integrated",
    "effort": "integrated",
    "skip_permissions": "vendor-unsupported",
    "resume_by_id": "integrated",
    "session_id_at_launch": "not-yet-integrated",
    "login": "unknown"
  },
  "observer": {
    "parser": "pi",
    "parser_id": "rust-pi-jsonl-v1",
    "platforms": ["unix"],
    "layouts": [{
      "source": "jsonl",
      "usage": "per_turn",
      "store_file": null,
      "request": ["cwd", "session", "now_ms"],
      "usage_fields": {
        "select": [{"pointer": "/kind", "equals": "usage"}],
        "object": "/usage",
        "input": ["/usage/input", "/usage/cacheRead", "/usage/cacheWrite"],
        "output": ["/usage/output"],
        "cache_read": [],
        "cache_creation": [],
        "key": ["/id"],
        "key_join": "",
        "model": "/model",
        "version": null,
        "timestamp": "/timestamp",
        "number": "lenient",
        "text": "string"
      },
      "store": null,
      "rules": {
        "missing_identity_rotates": true,
        "invalid_utf8_fails": true,
        "non_object_fails": false,
        "activity_non_object_fails": false,
        "totals_never_decrease": false,
        "water_survives_replacement": true
      }
    }],
    "core": {
      "modes": ["usage", "session_usage", "activity"],
      "messages": {"unsupported_mode": "Pi observation mode not integrated", "non_object": null},
      "legacy_state": [
        {"prefix": "act_hw::", "field": "water", "kind": "int"},
        {"prefix": "pi_text::", "field": "last_text", "kind": "text"},
        {"prefix": "pi_turn::", "field": "adapter", "kind": "json"}
      ],
      "python": {"prompt_detail": "user", "pane_scope": "none", "attribution": "none", "identity_source": "file_stem"},
      "compat": {
        "absent_file_is_empty": true,
        "no_python_turn_fallback": false,
        "store_error_reported": false
      }
    }
  }
}
