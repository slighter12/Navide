{
  "key": "muse",
  "composition": "rust",
  "command": "muse",
  "model_flag": "--model",
  "effort_flag": "--reasoning-effort",
  "known_efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"],
  "permission_flag": "--disable-approval",
  "resume_args": "resume {id}",
  "session_id_flag": null,
  "login_args": "login",
  "resume_aliases": null,
  "subcommand": null,
  "data_dirs": {"env": ["XDG_DATA_HOME"], "home": [".local", "share"], "append": ["muse"], "extra_env": [], "tilde": false},
  "session_root": {"root_env": [], "base_env": ["XDG_DATA_HOME"], "home": [".local", "share"], "fallbacks": [], "sub": ["muse", "sessions"]},
  "session_path": null,
  "logs": {"files": ["*/*/*/*/session.jsonl"], "cwd": "absent"},
  "permission_aliases": null,
  "supports_session_resume": true,
  "shutdown": null,
  "capabilities": {
    "model": "integrated",
    "effort": "integrated",
    "skip_permissions": "integrated",
    "resume_by_id": "integrated",
    "session_id_at_launch": "vendor-unsupported",
    "login": "integrated"
  },
  "observer": {
    "parser": "muse",
    "parser_id": "rust-muse-jsonl-v1",
    "platforms": ["unix"],
    "layouts": [{
      "source": "jsonl",
      "usage": "per_turn",
      "store_file": null,
      "request": ["cwd", "session", "cli_version"],
      "usage_fields": {
        "select": [
          {"pointer": "/payload_type", "equals": "runtime.session"},
          {"pointer": "/payload/event/kind", "equals": "goal_usage_attribution"},
          {"pointer": "/payload/event/record/owner/requester_kind", "equals": "main"}
        ],
        "object": "/payload/event/record/quantity",
        "input": ["/payload/event/record/quantity/input_tokens"],
        "output": ["/payload/event/record/quantity/output_tokens"],
        "cache_read": [],
        "cache_creation": [],
        "key": ["/payload/event/record/usage_id"],
        "key_join": "",
        "model": null,
        "version": null,
        "timestamp": "/recorded_at",
        "number": "lenient",
        "text": "string",
        "time": "epoch_micros"
      },
      "store": null,
      "rules": {
        "missing_identity_rotates": true,
        "invalid_utf8_fails": true,
        "non_object_fails": false,
        "activity_non_object_fails": false,
        "totals_never_decrease": false,
        "water_survives_replacement": true
      }
    }],
    "core": {
      "modes": ["usage", "session_usage", "activity"],
      "messages": {"unsupported_mode": "Muse observation mode not integrated", "non_object": null},
      "legacy_state": [
        {"prefix": "act_hw::", "field": "water", "kind": "int"},
        {"prefix": "muse_text::", "field": "last_text", "kind": "text"}
      ],
      "python": {"prompt_detail": "user", "pane_scope": "none", "attribution": "none", "identity_source": "file_stem"},
      "compat": {
        "absent_file_is_empty": false,
        "no_python_turn_fallback": false,
        "store_error_reported": false
      }
    }
  }
}
