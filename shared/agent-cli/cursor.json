{
  "key": "cursor",
  "composition": "rust",
  "command": "agent",
  "model_flag": "--model",
  "effort_flag": null,
  "known_efforts": null,
  "permission_flag": "--force",
  "resume_args": "--resume={id}",
  "session_id_flag": null,
  "login_args": null,
  "resume_aliases": {"programs": ["cursor-agent"], "flags": []},
  "subcommand": null,
  "data_dirs": {"env": [], "home": [".cursor", "chats"], "append": [], "extra_env": [], "tilde": false},
  "session_root": {"root_env": [], "base_env": [], "home": [".cursor", "chats"], "fallbacks": [], "sub": []},
  "session_path": null,
  "logs": {"files": ["{cwd}/*/store.db"], "cwd": "md5"},
  "permission_aliases": null,
  "supports_session_resume": true,
  "shutdown": null,
  "capabilities": {
    "model": "integrated",
    "effort": "vendor-unsupported",
    "skip_permissions": "integrated",
    "resume_by_id": "integrated",
    "session_id_at_launch": "unknown",
    "login": "unknown"
  },
  "observer": {
    "parser": "cursor",
    "parser_id": "rust-cursor-sqlite-v1",
    "platforms": ["unix"],
    "layouts": [{
      "source": "sqlite",
      "usage": "none",
      "store_file": "store.db",
      "request": ["cwd", "session", "base_epoch"],
      "usage_fields": null,
      "store": {
        "parent": null,
        "marks": [{"table": "blobs", "id": "rowid", "key": "id", "payload": "data", "prefix": "blob:",
                   "page": 512, "text_cap": 8000, "start": "newest_or_zero", "shrink": "newest"}],
        "marker": {"text": "at-pane:", "on": "blobs", "within": {"rows": 512, "bytes": 262144}, "binding": "path_session"}
      }
    }],
    "core": {
      "modes": ["usage", "session_usage", "activity", "identify"],
      "messages": {"unsupported_mode": "Cursor observation mode not integrated", "non_object": null},
      "legacy_state": [{"prefix": "cursor_blob::", "field": "marks.blobs.last", "kind": "int"}],
      "python": {"prompt_detail": "user", "pane_scope": "none", "attribution": "none", "identity_source": "store"},
      "compat": {
        "absent_file_is_empty": false,
        "no_python_turn_fallback": false,
        "store_error_reported": false
      }
    }
  }
}
