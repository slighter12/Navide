{
  "key": "kimi",
  "composition": "rust",
  "command": "kimi",
  "model_flag": "--model",
  "effort_flag": null,
  "known_efforts": null,
  "permission_flag": "--yolo",
  "resume_args": "--session {id}",
  "session_id_flag": null,
  "login_args": "login",
  "supports_session_resume": true,
  "shutdown": null,
  "capabilities": {
    "model": "integrated",
    "effort": "vendor-unsupported",
    "skip_permissions": "integrated",
    "resume_by_id": "integrated",
    "session_id_at_launch": "unknown",
    "login": "integrated"
  },
  "observer": {
    "parser": "kimi",
    "parser_id": "rust-kimi-jsonl-v1",
    "platforms": ["unix"],
    "layouts": [{
      "source": "jsonl",
      "usage": "per_turn",
      "store_file": null,
      "request": ["cwd", "session", "now_ms"],
      "usage_fields": {
        "select": [{"pointer": "/type", "equals": "usage.record"}],
        "object": "/usage",
        "input": ["/usage/inputOther", "/usage/inputCacheRead", "/usage/inputCacheCreation"],
        "output": ["/usage/output"],
        "cache_read": [],
        "cache_creation": [],
        "key": [],
        "key_join": "",
        "model": "/model",
        "version": null,
        "timestamp": "/time",
        "number": "lenient",
        "text": "any"
      },
      "store": null,
      "rules": {
        "missing_identity_rotates": true,
        "invalid_utf8_fails": true,
        "non_object_fails": true,
        "activity_non_object_fails": true,
        "totals_never_decrease": false,
        "water_survives_replacement": true
      }
    }],
    "core": {
      "modes": ["usage", "session_usage", "activity"],
      "messages": {"unsupported_mode": "Kimi observation mode not integrated", "non_object": "Kimi record is not an object"},
      "legacy_state": [
        {"prefix": "act_hw::", "field": "water", "kind": "int"},
        {"prefix": "kimi_text::", "field": "last_text", "kind": "text"},
        {"prefix": "kimi_turn::", "field": "adapter", "kind": "json"}
      ],
      "python": {"prompt_detail": "prompt", "pane_scope": "none", "attribution": "none", "identity_source": "file_stem"},
      "compat": {
        "absent_file_is_empty": false,
        "no_python_turn_fallback": false,
        "store_error_reported": false
      }
    }
  }
}
