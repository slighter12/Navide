{
  "rule": "One vector file for the launch-word spelling and the resume reader, read by pytest (backend/tests/test_launch_word_vectors.py), vitest (src/shared/launchWords.vectors.test.ts) and cargo test (native/navide-cli-runtime/src/compose.rs). The spelling of every option comes from the generated option table (OPTIONS / OPTION_RULES / Opt); these vectors pin the result in each language, for the POSIX and the Windows quoting grammar.",
  "words_to_text": {
    "rule": "`words` are the wire words (an opt carries no text). `posix` and `windows` are the text the words compose to under that grammar. `renderer` names whether the vitest reader runs the vector: 'safe' when every value needs no quoting (the renderer has no quoting rules of its own, so it spells only those), else 'skip'.",
    "vectors": [
      {"name": "claude: every option", "vendor": "claude", "renderer": "safe",
       "words": [{"exe": "claude"}, {"opt": "model", "value": "opus"}, {"opt": "effort", "value": "high"}, {"opt": "skip_permissions"}, {"opt": "resume", "value": "abc-123"}, {"opt": "session_id", "value": "sid-1"}],
       "posix": "claude --model opus --effort high --dangerously-skip-permissions --resume abc-123 --session-id sid-1",
       "windows": "claude --model opus --effort high --dangerously-skip-permissions --resume abc-123 --session-id sid-1"},
      {"name": "claude: login", "vendor": "claude", "renderer": "safe",
       "words": [{"exe": "claude"}, {"opt": "login"}],
       "posix": "claude auth login", "windows": "claude auth login"},
      {"name": "claude: a literal and an argument around the options", "vendor": "claude", "renderer": "safe",
       "words": [{"lit": "claude --keep"}, {"opt": "model", "value": "m1"}, {"arg": "x"}],
       "posix": "claude --keep --model m1 x", "windows": "claude --keep --model m1 x"},
      {"name": "claude: a value with a space is quoted by the grammar", "vendor": "claude", "renderer": "skip",
       "words": [{"exe": "claude"}, {"opt": "model", "value": "a b"}],
       "posix": "claude --model 'a b'", "windows": "claude --model \"a b\""},
      {"name": "claude: a value with a quote", "vendor": "claude", "renderer": "skip",
       "words": [{"exe": "claude"}, {"opt": "session_id", "value": "it's"}],
       "posix": "claude --session-id 'it'\"'\"'s'", "windows": "claude --session-id it's"},
      {"name": "codex: the resume template holds the id after a word", "vendor": "codex", "renderer": "safe",
       "words": [{"exe": "codex"}, {"opt": "resume", "value": "019a-x"}],
       "posix": "codex resume 019a-x", "windows": "codex resume 019a-x"},
      {"name": "codex: model and the permission flag", "vendor": "codex", "renderer": "safe",
       "words": [{"exe": "codex"}, {"opt": "skip_permissions"}, {"opt": "model", "value": "gpt-x"}],
       "posix": "codex --dangerously-bypass-approvals-and-sandbox --model gpt-x", "windows": "codex --dangerously-bypass-approvals-and-sandbox --model gpt-x"},
      {"name": "codex: a resume id that needs quoting fills the template quoted", "vendor": "codex", "renderer": "skip",
       "words": [{"exe": "codex"}, {"opt": "resume", "value": "a b"}],
       "posix": "codex resume 'a b'", "windows": "codex resume \"a b\""},
      {"name": "cursor: the template joins the flag and the id with =", "vendor": "cursor", "renderer": "safe",
       "words": [{"exe": "agent"}, {"opt": "resume", "value": "abc"}],
       "posix": "agent --resume=abc", "windows": "agent --resume=abc"},
      {"name": "goose: the template starts with a subcommand", "vendor": "goose", "renderer": "safe",
       "words": [{"exe": "goose"}, {"opt": "resume", "value": "abc"}],
       "posix": "goose session -r --session-id abc", "windows": "goose session -r --session-id abc"},
      {"name": "pi: effort is the thinking level", "vendor": "pi", "renderer": "safe",
       "words": [{"exe": "pi"}, {"opt": "effort", "value": "off"}],
       "posix": "pi --thinking off", "windows": "pi --thinking off"},
      {"name": "grok: login", "vendor": "grok", "renderer": "safe",
       "words": [{"exe": "grok"}, {"opt": "login"}],
       "posix": "grok login", "windows": "grok login"},
      {"name": "a Windows value that ends in a backslash", "vendor": "claude", "renderer": "skip",
       "words": [{"exe": "claude"}, {"opt": "model", "value": "C:\\a b\\"}],
       "posix": "claude --model 'C:\\a b\\'", "windows": "claude --model \"C:\\a b\\\\\""}
    ],
    "refused": [
      {"name": "a capability that is not integrated", "vendor": "aider", "words": [{"exe": "aider"}, {"opt": "model", "value": "m"}], "renderer": "omitted"},
      {"name": "no resume flag and not integrated", "vendor": "mcode", "words": [{"exe": "mcode"}, {"opt": "resume", "value": "x"}], "renderer": "omitted"},
      {"name": "an effort the vendor does not list", "vendor": "claude", "words": [{"exe": "claude"}, {"opt": "effort", "value": "bogus"}], "renderer": "literal", "literal": " --effort bogus"},
      {"name": "a value option with no value", "vendor": "claude", "words": [{"exe": "claude"}, {"opt": "model"}], "renderer": "omitted"},
      {"name": "an option the table does not name", "vendor": "claude", "words": [{"exe": "claude"}, {"opt": "bogus"}], "renderer": "none"},
      {"name": "a subject that declares no options", "vendor": "terminal", "words": [{"exe": "zsh"}, {"opt": "model", "value": "m"}], "renderer": "none"}
    ]
  },
  "resume_ids": {
    "rule": "`line` is a command line the vendor's reader reads for the session it resumes. `grammar` 'posix' marks a line whose answer depends on the POSIX tokenizer (a backslash escape): the Windows grammar reads it differently, so the Python vector runs on POSIX only. `readers` lists the languages that run the vector: 'python' alone is a named rule the renderer has no counterpart of: `plain_only` (a line with shell syntax names no resume) and Grok's UUID-only id (a title is not an id). The renderer reads the id out of such a line; it only displays or compares it, and the backend decides.",
    "vectors": [
      {"vendor": "claude", "line": "claude --resume abc", "id": "abc"},
      {"vendor": "claude", "line": "claude --model x --resume abc --effort high", "id": "abc"},
      {"vendor": "claude", "line": "claude --resume=abc", "id": "abc"},
      {"vendor": "claude", "line": "claude --resume", "id": ""},
      {"vendor": "claude", "line": "claude --resume -x", "id": ""},
      {"vendor": "claude", "line": "claude -- --resume abc", "id": ""},
      {"vendor": "claude", "line": "claude --model x", "id": ""},
      {"vendor": "claude", "line": "other --resume abc", "id": ""},
      {"vendor": "claude", "line": "claude --resume 'a b'", "id": "a b", "grammar": "posix"},
      {"vendor": "claude", "line": "claude --resume \"a b\"", "id": "a b"},
      {"vendor": "claude", "line": "claude --resume a\"b c\"", "id": "ab c"},
      {"vendor": "claude", "line": "claude --resume a''b", "id": "ab", "grammar": "posix"},
      {"vendor": "claude", "line": "claude --resume a\\ b", "id": "a b", "grammar": "posix"},
      {"vendor": "claude", "line": "claude --resume 'unterminated", "id": "'unterminated"},
      {"vendor": "codex", "line": "codex resume abc", "id": "abc"},
      {"vendor": "codex", "line": "codex resume", "id": ""},
      {"vendor": "codex", "line": "codex --model x resume abc", "id": ""},
      {"vendor": "cursor", "line": "agent --resume=abc", "id": "abc"},
      {"vendor": "cursor", "line": "agent --resume abc", "id": "abc"},
      {"vendor": "goose", "line": "goose session -r --session-id abc", "id": "abc"},
      {"vendor": "goose", "line": "goose s --session-id abc", "id": "abc"},
      {"vendor": "goose", "line": "goose --session-id abc", "id": ""},
      {"vendor": "qwen", "line": "qwen -r abc", "id": "abc"},
      {"vendor": "qwen", "line": "qwen --resume abc", "id": "abc"},
      {"vendor": "opencode", "line": "opencode -s abc", "id": "abc"},
      {"vendor": "kimi", "line": "kimi -S abc", "id": "abc"},
      {"vendor": "grok", "line": "grok -r 0192a3b4-1111-4222-8333-444455556666", "id": "0192a3b4-1111-4222-8333-444455556666"},
      {"vendor": "grok", "line": "grok --resume=0192a3b4-1111-4222-8333-444455556666", "id": "0192a3b4-1111-4222-8333-444455556666"},
      {"vendor": "grok", "line": "grok -r 0192a3b4-1111-4222-8333-444455556666; rm x", "id": "", "readers": ["python"]},
      {"vendor": "grok", "line": "grok -r 0192a3b4-1111-4222-8333-444455556666 | tee x", "id": "", "readers": ["python"]},
      {"vendor": "grok", "line": "grok -r a-title", "id": "", "readers": ["python"]},
      {"vendor": "mcode", "line": "mcode --resume abc", "id": ""}
    ]
  }
}
